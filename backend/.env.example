# Server
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas
MONGO_URI=ADD YOURS HERE
DB_NAME=vision_grade

# LLM — Groq primary, Gemini fallback (Module 1 generation)
GROQ_API_KEY=ADD YOURS HERE
GEMINI_API_KEY=ADD YOURS HERE
# Optional — run `node scripts/list-groq-models.js` to see models on your key
GROQ_MODEL=openai/gpt-oss-20b
# Gemini models tried in order (comma-separated). Also used to mark sheets from
# the photo (Module 2 primary scorer). Requires a key from https://aistudio.google.com/app/apikey
# GEMINI_MODELS=gemini-2.5-flash
# Vision-capable Groq model used to mark sheets if Gemini vision fails/is rate-limited.
# Groq only supports vision on Llama 4 Scout/Maverick, and NOT every account/key
# has access to them (some get a 404 even though the model exists) — if that's
# you, Groq vision will always fail over to OpenRouter below, which is expected.
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Pause between LLM batches to avoid Groq TPM limits (milliseconds)
# LLM_BATCH_PAUSE_MS=1200

# Third-tier fallback used everywhere (topics, question/answer generation, vision
# scoring) once BOTH Groq and Gemini are rate-limited/unavailable.
# Get a free key at https://openrouter.ai/keys
# OpenRouter renames/retires free-tier slugs periodically — if these 404, list
# current free models with: curl https://openrouter.ai/api/v1/models | jq '.data[] | select(.id | endswith(":free"))'
OPENROUTER_API_KEY=ADD YOURS HERE
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
# Comma-separated — tried in order; each free model has its own separate daily rate limit
# OPENROUTER_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free,google/gemma-4-26b-a4b-it:free

# Cloudinary (PDF upload + storage)
CLOUDINARY_CLOUD_NAME=ADD YOURS HERE
CLOUDINARY_API_KEY=ADD YOURS HERE
CLOUDINARY_API_SECRET=ADD YOURS HERE

# Auth
JWT_SECRET=ADD YOURS HERE
JWT_EXPIRES_IN=7d

# Upload limits
MAX_FILE_SIZE_MB=50

# LaTeX PDF export — online by default (no local install needed)
LATEX_COMPILE_MODE=online
LATEX_COMPILE_URL=https://latexonline.cc/compile
# Optional local compile instead: LATEX_COMPILE_MODE=local and TECTONIC_PATH=C:\path\to\tectonic.exe

# Unused on current branch (leave empty)
OPENAI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
